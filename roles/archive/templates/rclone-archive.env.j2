RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_REGION={{ archive_region }}
RCLONE_CONFIG_S3_ACCESS_KEY_ID={{ archive_aws_access_key_id }}
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY={{ archive_aws_secret_access_key }}
RCLONE_CONFIG_S3_STORAGE_CLASS={{ archive_storage_class }}
RCLONE_CONFIG_S3_NO_CHECK_BUCKET=true
RCLONE_CONFIG_ARCHIVE_TYPE=crypt
RCLONE_CONFIG_ARCHIVE_REMOTE=s3:{{ archive_bucket }}
ARCHIVE_CRYPT_PASSWORD={{ archive_crypt_password }}
ARCHIVE_CRYPT_SALT={{ archive_crypt_salt }}
