---
storage:
  type: sqlite
  path: /data/data.db

alerting:
  telegram:
    token: "{{ telegram_alert_bot_token }}"
    id: "{{ telegram_user_id }}"
    default-alert:
      enabled: true
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true
      description: "health check failed"

ui:
  title: "{{ 'External status' if gatus_external else 'Status' }}"
  header: "{{ 'External status' if gatus_external else 'Status' }}"

endpoints:
{% if gatus_external %}
{% for e in gatus_external_endpoints %}
  - name: "{{ e.name }}"
    group: {{ e.group }}
    url: "{{ e.url }}"
    interval: 2m
    conditions:
      - "[CONNECTED] == true"
{% if not e.url.startswith('tcp://') %}
      - "[STATUS] < 400"
{% endif %}
    alerts:
      - type: telegram

{% endfor %}
{% else %}
  - name: Traefik
    group: Infrastructure
    url: "http://traefik:80"
    interval: 5m
    client:
      ignore-redirect: true
    conditions:
      - "[CONNECTED] == true"
      - "[STATUS] < 500"
    alerts:
      - type: telegram

