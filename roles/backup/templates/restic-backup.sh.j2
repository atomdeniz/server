#!/usr/bin/env bash
set -euo pipefail

REPO="{{ restic_repo_path }}"
PASSWORD_FILE="/etc/restic-password"
DUMP_DIR="{{ restic_db_dump_dir }}"
TEXTFILE="{{ node_exporter_textfile_dir | default('/var/lib/node_exporter') }}/restic.prom"
TEXTFILE_R2="{{ node_exporter_textfile_dir | default('/var/lib/node_exporter') }}/restic-r2.prom"
TELEGRAM_API="https://api.telegram.org/bot{{ telegram_alert_bot_token }}/sendMessage"
HOSTNAME=$(hostname)

export RESTIC_REPOSITORY="$REPO"
export RESTIC_PASSWORD_FILE="$PASSWORD_FILE"
export RESTIC_COMPRESSION="auto"
export RESTIC_CACHE_DIR="/var/cache/restic"

send_telegram() {
  local title="$1"
  local body="$2"
  curl -s -o /dev/null "$TELEGRAM_API" \
    --data-urlencode "chat_id={{ telegram_user_id }}" \
    --data-urlencode "text=$title"$'\n\n'"$body"
}

# Expose last-success timestamp to node_exporter (backup-age alerting)
write_metric() {
  if [ -d "$(dirname "$1")" ]; then
    printf '%s %s\n' "$2" "$(date +%s)" > "$1.tmp" && mv "$1.tmp" "$1"
  fi
}

LOG=$(mktemp)
STATUS="SUCCESS"

set +e
(
  set -e
  echo "[$(date)] Starting backup..."

  # Pre-backup: dump PostgreSQL
  if docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -q '^{{ postgres_container_name }}$'; then
    echo "Dumping PostgreSQL..."
    docker exec {{ postgres_container_name }} pg_dumpall -U {{ postgres_bootstrap_user }} > "$DUMP_DIR/postgres.sql"
  fi

  if docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -q '^{{ restic_immich_db_container }}$'; then
    echo "Dumping Immich PostgreSQL..."
    docker exec {{ restic_immich_db_container }} sh -c 'pg_dumpall --clean --if-exists -U "$POSTGRES_USER"' > "$DUMP_DIR/immich.sql"
  fi

  # Run backup
  restic backup {{ restic_backup_path }} \
{% for path in restic_exclude_paths %}
    --exclude "{{ path }}" \
{% endfor %}
    --tag automated

  # Apply retention policy
  restic forget \
    --keep-daily {{ restic_keep_daily }} \
    --keep-weekly {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --prune

  # Verify repository integrity
  echo "Verifying backup integrity..."
  restic check

  # Snapshot summary
  restic snapshots --latest 1

  echo "[$(date)] Backup complete."
) > "$LOG" 2>&1
[ $? -eq 0 ] || STATUS="FAILED"
set -e
MAIN_STATUS="$STATUS"
{% if restic_r2_enabled | bool %}

R2_STATUS="SUCCESS"
set +e
(
  set -e
  set -a
  . {{ restic_r2_env_file }}
  set +a
  export RESTIC_REPOSITORY="{{ restic_r2_repo }}"
  echo "[$(date)] Starting R2 backup..."

  restic backup {{ restic_backup_path }} \
{% for path in restic_r2_exclude_paths %}
    --exclude "{{ path }}" \
{% endfor %}
    --tag automated

  restic forget \
    --keep-daily {{ restic_keep_daily }} \
    --keep-weekly {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --prune

  restic check
  restic stats --mode raw-data

  echo "[$(date)] R2 backup complete."
) >> "$LOG" 2>&1
[ $? -eq 0 ] || R2_STATUS="FAILED"
set -e
[ "$R2_STATUS" = "SUCCESS" ] || STATUS="FAILED"
{% endif %}

if [ "$MAIN_STATUS" = "SUCCESS" ]; then
  write_metric "$TEXTFILE" restic_last_success_timestamp_seconds
fi
{% if restic_r2_enabled | bool %}
if [ "$R2_STATUS" = "SUCCESS" ]; then
  write_metric "$TEXTFILE_R2" restic_r2_last_success_timestamp_seconds
fi
{% endif %}

if [ "$STATUS" = "SUCCESS" ]; then
  send_telegram "✅ Backup OK - $HOSTNAME - $(date +%Y-%m-%d)" "$(tail -5 "$LOG")"
else
  # Telegram 4096-char limit
  send_telegram "❌ Backup FAILED - $HOSTNAME - $(date +%Y-%m-%d)" "$(tail -20 "$LOG" | tail -c 3500)"
fi
rm -f "$LOG"

[ "$STATUS" = "SUCCESS" ] || exit 1
