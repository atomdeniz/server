#!/usr/bin/env bash
set -euo pipefail

DUMP_DIR="{{ restic_db_dump_dir }}"
TEXTFILE_DIR="{{ node_exporter_textfile_dir | default('/var/lib/node_exporter') }}"
TELEGRAM_API="https://api.telegram.org/bot{{ telegram_alert_bot_token }}/sendMessage"
HOSTNAME=$(hostname)

export RESTIC_PASSWORD_FILE="/etc/restic-password"
export RESTIC_COMPRESSION="auto"
export RESTIC_CACHE_DIR="/var/cache/restic"

send_telegram() {
  local title="$1"
  local body="$2"
  curl -s -o /dev/null "$TELEGRAM_API" \
    --data-urlencode "chat_id={{ telegram_user_id }}" \
    --data-urlencode "text=$title"$'\n\n'"$body"
}

# Expose last-success timestamp to node_exporter (backup-age alerting)
write_metric() {
  if [ -d "$TEXTFILE_DIR" ]; then
    printf '%s %s\n' "$2" "$(date +%s)" > "$TEXTFILE_DIR/$1.tmp" && mv "$TEXTFILE_DIR/$1.tmp" "$TEXTFILE_DIR/$1"
  fi
}

container_running() {
  docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -q "^$1\$"
}

dump_databases() {
  if container_running {{ postgres_container_name | default('postgres') }}; then
    echo "Dumping PostgreSQL..."
    docker exec {{ postgres_container_name | default('postgres') }} pg_dumpall --clean --if-exists -U {{ postgres_bootstrap_user | default('postgres') }} > "$DUMP_DIR/postgres.sql"
  fi

  if container_running {{ restic_immich_db_container }}; then
    echo "Dumping Immich PostgreSQL..."
    docker exec {{ restic_immich_db_container }} sh -c 'pg_dumpall --clean --if-exists -U "$POSTGRES_USER"' > "$DUMP_DIR/immich.sql"
  fi
{% for db in restic_sqlite_dumps %}

  echo "Dumping SQLite {{ db.name }}..."
  python3 -c 'import sqlite3, sys; s = sqlite3.connect(sys.argv[1]); d = sqlite3.connect(sys.argv[2]); s.backup(d); d.close(); s.close()' \
    "{{ db.path }}" "$DUMP_DIR/{{ db.name }}.sqlite.tmp"
  mv "$DUMP_DIR/{{ db.name }}.sqlite.tmp" "$DUMP_DIR/{{ db.name }}.sqlite"
{% endfor %}
}

backup_repo() {
  local label="$1"
  shift
  echo "[$(date)] Starting $label backup..."
  restic backup {{ restic_backup_path }} "$@" --tag automated
  restic forget \
    --keep-daily {{ restic_keep_daily }} \
    --keep-weekly {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --prune
  restic check
  restic snapshots --latest 1
  echo "[$(date)] $label backup complete."
}

LOG=$(mktemp)
STATUS="SUCCESS"

set +e
( set -e; dump_databases ) > "$LOG" 2>&1
[ $? -eq 0 ] || STATUS="FAILED"
{% if restic_storagebox_enabled | bool %}

(
  set -e
  export RESTIC_REPOSITORY="{{ restic_repo_path }}"
  backup_repo "Storage Box" \
{% for path in restic_exclude_paths + restic_extra_exclude_paths %}
    --exclude "{{ path }}" \
{% endfor %}

) >> "$LOG" 2>&1
if [ $? -eq 0 ]; then
  write_metric restic.prom restic_last_success_timestamp_seconds
else
  STATUS="FAILED"
fi
{% endif %}
{% if restic_r2_enabled | bool %}

(
  set -e
  set -a
  . {{ restic_r2_env_file }}
  set +a
  export RESTIC_REPOSITORY="{{ restic_r2_repo }}"
  backup_repo "R2" \
{% for path in restic_r2_exclude_paths %}
    --exclude "{{ path }}" \
{% endfor %}

) >> "$LOG" 2>&1
if [ $? -eq 0 ]; then
  write_metric restic-r2.prom restic_r2_last_success_timestamp_seconds
else
  STATUS="FAILED"
fi
{% endif %}
set -e

if [ "$STATUS" = "SUCCESS" ]; then
  send_telegram "✅ Backup OK - $HOSTNAME - $(date +%Y-%m-%d)" "$(tail -5 "$LOG")"
else
  # Telegram 4096-char limit
  send_telegram "❌ Backup FAILED - $HOSTNAME - $(date +%Y-%m-%d)" "$(tail -20 "$LOG" | tail -c 3500)"
fi
rm -f "$LOG"

[ "$STATUS" = "SUCCESS" ] || exit 1
