      "depNameTemplate": "adguard/adguardhome",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-b\\.(?<build>\\d+)$"
    },
    {
