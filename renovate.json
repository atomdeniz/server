{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "ansible-galaxy",
    "github-actions"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "* 6-10 * * 1"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "jpillora/chisel"
      ],
      "groupName": "chisel"
    },
    {
      "matchDepNames": [
        "ghcr.io/immich-app/immich-server"
      ],
      "groupName": "immich"
    },
    {
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.\\d+-slim$/"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles/backup/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "restic_version: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "restic/restic",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles/backrest/defaults/main\\.yml$/"
      ],
      "matchStrings": [
